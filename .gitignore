# Build artifacts (all root-level CMake build trees)
/build*/

# ROM files (copyrighted)
*.smc
*.sfc
*.rom

# Third-party ROM patches (not this project's work -- reference-only,
# never redistributed from this repo)
*.ips

# Active recompiler output -- generated locally per-developer
src/gen/

# Extracted graphics/text (tools/extract_graphics.py output) -- derived
# from the copyrighted ROM, generated locally per-developer
/extracted_assets/

# Save files
saves/
*.sav
*.srm

# IDE
.vs/
*.vcxproj.user

# OS
Thumbs.db
.DS_Store

# Python caches
__pycache__/
*.pyc

# Local-only config overrides (per-developer, applied after config.ini)
config.local.ini

# Boot traces / triage scratch (generated at runtime)
boot_trace*.txt
_*

# On-demand WRAM snapshots (F4 hotkey) and other ad-hoc runtime dumps --
# generated locally per-debugging-session, derived from the copyrighted
# ROM's runtime state
wram_snapshot.bin
*.wram

# Save states (numbered-slot hotkeys / --load-state) -- full emulator
# snapshots derived from the copyrighted ROM's runtime state, generated
# locally per-debugging-session
savestate_*.bin
menu_preview.ppm

# Local visual reference, kept for designing a future project logo. The
# official SimCity wordmark is Maxis/Nintendo artwork, so it stays local
# and is deliberately not distributed with this repository -- same
# reasoning as the ROM and the save states above.
logo.png

# Third-party reference tool (Brad Smith, rainwarrior.ca) -- no stated
# licence, so kept local and not redistributed. Findings are recorded in
# docs/REFERENCE_map_format.md instead.
SimCity_map.lua

# Recorded-session artifacts. Both are derived from the copyrighted ROM --
# coverage.bin is a map of which ROM addresses executed, session_sram.bin is
# the game's own save data -- so they stay local, same reasoning as the ROM
# and save states above. What they were USED for is committed (the cfg
# entry points in recomp/, and the measurements in README.md); the captures
# themselves are not.
coverage*.bin
wram_map*.bin
session_sram.bin
*_sram.bin

# SC_MX_BITMAP captures -- the same execution map as coverage*.bin, split by
# the live (m,x) width flags. Same reasoning: derived from the copyrighted
# ROM, so the capture stays local while what it established is committed
# (the exit_mx_at/entry_mx_at directives in recomp/ and the numbers in
# README.md). Regenerate with SC_MX_BITMAP=<path> on any run.
mx_*.bin

# Hand-drawn card artwork for the ninth scenario entry, and what
# tools/make_sylt_card.py derives from it. Kept out for the same reason as
# everything else here: the repo carries code and findings, not assets. The
# host loads sylt_card.bin at runtime and falls back to a drawn placeholder
# when it is missing, so a checkout without this still builds and still shows
# a ninth entry. Regenerate with:
#   python tools/make_sylt_card.py sylt_graphics/<your card>.jpg
sylt_graphics/
